generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String         @id
  name                String
  displayName         String?
  email               String         @unique
  phone               String?
  campusId            String
  role                String         @default("member")
  /** member = church member (may have no groups); visitor; guest */
  participationType   String         @default("member")
  avatarUrl           String?
  passwordHash        String
  pushEnabled         Boolean        @default(true)
  notifyDevotions     Boolean        @default(true)
  notifyMessages      Boolean        @default(true)
  notifyGroupChat     Boolean        @default(true)
  notifyAnnouncements Boolean        @default(true)
  notifyWorship       Boolean        @default(true)
  notifyKids          Boolean        @default(true)
  stripeCustomerId    String?        @unique
  createdAt           DateTime
  updatedAt           DateTime
  family              FamilyMember[]
  sessions            Session[]
  activities          ActivityLog[]
}

model FamilyMember {
  id                String  @id
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  relationship      String
  birthYear         String?
  notes             String?
  allergies         String?
  medicalNotes      String?
  authorizedPickup  Json?
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model ActivityLog {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  label     String
  createdAt DateTime
}

model MessageThread {
  id                  String    @id
  participantAId      String
  participantBId      String
  participantNames    Json
  participantIds      Json?
  isGroup             Boolean   @default(false)
  disappearingSeconds Int       @default(0)
  lastMessage         String
  lastMessageAt       DateTime
  createdAt           DateTime
  messages            Message[]
}

model Message {
  id             String        @id
  threadId       String
  thread         MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId       String
  senderName     String
  content        String
  reactions      Json?
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  editedAt       DateTime?
  deletedAt      DateTime?
  replyToMessageId   String?
  replyToSenderId    String?
  replyToSenderName  String?
  replyToExcerpt     String?
  createdAt      DateTime
  expiresAt      DateTime?
  readAt         DateTime?
}

model UserBlock {
  id              String   @id
  blockerId       String
  blockedUserId   String
  blockedUserName String
  createdAt       DateTime
}

model MessageReport {
  id               String   @id
  reporterId       String
  reporterName     String
  reportedUserId   String
  reportedUserName String
  threadId         String?
  groupId          String?
  messageId        String?
  reason           String
  status           String   @default("open")
  createdAt        DateTime
}

model Group {
  id              String   @id
  name            String
  description     String
  category        String
  campusId        String?
  createdBy       String
  creatorName     String
  visibility      String
  meetingSchedule String?
  meetingLink     String?
  iconUrl         String?
  memberIds       Json
  adminIds        Json
  assistantAdminIds Json   @default("[]")
  requiresApproval Boolean @default(false)
  isSystem        Boolean @default(false)
  signupVisible   Boolean @default(true)
  createdAt       DateTime
  updatedAt       DateTime
}

model GroupJoinRequest {
  id             String    @id
  groupId        String
  groupName      String
  userId         String
  userName       String
  userEmail      String
  status         String    @default("pending")
  requestedAt    DateTime
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewedByName String?
}

model CommunityPost {
  id              String    @id
  author          String
  authorId        String?
  campusId        String
  content         String
  mediaUrl        String?
  mediaType       String?
  mediaItems      Json?
  timeAgo         String
  type            String
  reactions       Int       @default(0)
  targetGroupId   String?
  targetGroupName String?
  createdAt       DateTime  @default(now())
  comments        Comment[]
}

model CommunityPostReaction {
  id        String   @id
  postId    String
  userId    String
  kind      String
  createdAt DateTime @default(now())

  @@unique([postId, userId, kind])
  @@index([postId])
}

model CommunityStatus {
  id                    String   @id
  authorId              String
  authorName            String
  mediaUrl              String
  mediaType             String
  caption               String?
  storyKind             String   @default("default")
  groupId               String?
  postedByUserId        String?
  musicTrackId          String?
  musicTitle            String?
  musicArtist           String?
  musicYoutubeVideoId   String?
  memberStoryAudioUrl   String?
  createdAt             DateTime @default(now())
  expiresAt             DateTime

  @@index([expiresAt])
  @@index([authorId])
  @@index([groupId])
}

model CommunityStatusReaction {
  id        String   @id
  statusId  String
  userId    String
  kind      String
  createdAt DateTime @default(now())

  @@unique([statusId, userId, kind])
  @@index([statusId])
}

model CommunityStatusReply {
  id         String   @id
  statusId   String
  authorId   String
  authorName String
  content    String
  createdAt  DateTime @default(now())

  @@index([statusId])
}

model CommunityLiveJoinRequest {
  id        String   @id
  statusId  String
  userId    String
  userName  String
  state     String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([statusId, userId])
  @@index([statusId, state])
}

model CommunityLiveCoHost {
  id        String   @id
  statusId  String
  userId    String
  userName  String
  createdAt DateTime @default(now())

  @@unique([statusId, userId])
  @@index([statusId])
}

model Comment {
  id        String                     @id
  postId    String
  post      CommunityPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?                   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]                  @relation("CommentReplies")
  author    String
  authorId  String?
  content   String
  createdAt DateTime
  reactions CommunityCommentReaction[]

  @@index([postId])
  @@index([parentId])
}

model CommunityCommentReaction {
  id        String   @id
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  kind      String
  createdAt DateTime @default(now())

  @@unique([commentId, userId, kind])
  @@index([commentId])
}

model Devotion {
  id          String    @id
  title       String
  verse       String
  reference   String
  readingTime String
  content     String
  prayer      String
  date        String
  published   Boolean   @default(true)
  authorId    String?
  authorName  String?
  audioUrl    String?
  audioName   String?
  artworkSquareUrl String?
  artworkWideUrl   String?
  artworkBannerUrl String?
  createdAt   DateTime?
  updatedAt   DateTime?
  publishAt   DateTime?
  notifiedAt  DateTime?
  tags        Json?
}

model DevotionReaction {
  id         String   @id
  devotionId String
  userId     String
  userName   String
  emoji      String
  createdAt  DateTime

  @@unique([devotionId, userId, emoji])
  @@index([devotionId])
}

model ChurchEvent {
  id               String      @id
  title            String
  date             String
  time             String
  location         String
  campusId         String?
  groupId          String?
  groupName        String?
  startsOn         String?
  endsOn           String?
  recurringWeekday Int?
  artworkSquareUrl String?
  artworkWideUrl   String?
  artworkBannerUrl String?
  published        Boolean     @default(true)
  sortOrder        Int         @default(0)
  rsvpEnabled      Boolean     @default(false)
  rsvpAudience     String?
  rsvpGroupId      String?
  rsvpGroupName    String?
  rsvpDeadline     DateTime?
  rsvpCapacity     Int?
  rsvpInstructions String?
  rsvpLastNotifiedAt DateTime?
  rsvpCouplesMode  Boolean     @default(false)
  createdAt        DateTime
  updatedAt        DateTime
  rsvps            EventRsvp[]
}

model EventRsvp {
  id        String      @id
  eventId   String
  event     ChurchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  userEmail String
  status    String
  note      String?
  guestCount Int        @default(1)
  spouseName String?
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
}

model Meeting {
  id                 String   @id
  title              String
  campusId           String
  host               String
  schedule           String
  platform           String
  joinUrl            String?
  location           String?
  meetingId          String?
  passcode           String?
  startsOn           String?
  endsOn             String?
  recurringWeekday   Int?
  recurringWeekdays  String?
  notifyEnabled      Boolean  @default(false)
  lastNotifiedOn     String?
  published          Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime
  updatedAt          DateTime
}

model RateLimitEntry {
  key     String   @id
  count   Int
  resetAt DateTime
}

model PushSubscription {
  id           String   @id
  userId       String
  endpoint     String   @unique
  subscription Json
  createdAt    DateTime
  updatedAt    DateTime
}

model NativePushToken {
  id        String   @id
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime
  updatedAt DateTime
}

model VolunteerCheckIn {
  id             String   @id
  name           String
  ministry       String
  checkedInAt    DateTime
  atChurch       Boolean
  distanceMeters Float
}

model KidCheckIn {
  id               String    @id
  parentName       String
  parentUserId     String?
  familyMemberId   String?
  childName        String
  ageGroup         String
  service          String
  notes            String?
  allergies        String?
  medicalNotes     String?
  authorizedPickup Json?
  securityCode     String
  checkedInAt      DateTime
  checkedOutAt     DateTime?
  checkedOutBy     String?
  pickupVerified   Boolean   @default(false)
  pickupVerifiedAt DateTime?
}

model KidsLesson {
  id             String    @id
  weekStarting   String
  ageGroup       String
  title          String
  content        String
  status         String    @default("draft")
  publishedAt    DateTime?
  createdBy      String
  createdByName  String
  createdAt      DateTime
  updatedAt      DateTime

  @@unique([weekStarting, ageGroup])
}

model KidsIncident {
  id             String    @id
  checkInId      String?
  childName      String
  parentUserId   String?
  ageGroup       String
  service        String
  severity       String
  summary        String
  details        String?
  actionTaken    String?
  reportedBy     String
  reportedByName String
  parentNotified Boolean   @default(false)
  notifiedAt     DateTime?
  createdAt      DateTime
}

model UnavailabilityRequest {
  id          String    @id
  personName  String
  group       String
  startDate   String
  endDate     String
  reason      String
  status      String
  submittedAt DateTime
  reviewedAt  DateTime?
  reviewedBy  String?
}

model GalleryPhoto {
  id           String   @id
  url          String
  title        String
  album        String
  uploadedAt   DateTime
  uploadedBy   String?
  linkProvider String?
  visibility   String   @default("private")
}

model GalleryDownload {
  id             String   @id
  photoId        String
  photoTitle     String
  userId         String
  userName       String
  userEmail      String
  downloadedAt   DateTime
  acceptedPolicy Boolean
  policyVersion  String
}

model MediaClip {
  id          String    @id
  title       String
  platform    String
  url         String
  videoId     String?
  thumbnail   String?
  publishedAt DateTime?
}

model MeetingClick {
  id           String   @id
  userId       String
  userName     String
  userEmail    String
  meetingId    String?
  meetingTitle String
  groupId      String?
  groupName    String?
  campusId     String?
  platform     String?
  source       String
  joinUrl      String
  clickedAt    DateTime

  @@index([clickedAt])
  @@index([groupId])
  @@index([meetingId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime
}

model GivingRecord {
  id             String   @id
  userId         String?
  donorName      String
  donorEmail     String?
  amount         Float
  currency       String   @default("USD")
  fund           String
  method         String
  givenOn        String
  campusId       String?
  notes          String?
  source         String   @default("manual")
  stripeSessionId String? @unique
  stripeInvoiceId String? @unique
  recordedBy     String
  recordedByName String
  thankYouSentAt DateTime?
  createdAt      DateTime
  updatedAt      DateTime

  @@index([givenOn])
  @@index([userId])
  @@index([fund])
}

model FinanceWeeklySheet {
  id              String    @id
  weekEnding      String    @unique
  lines           Json
  notes           String?
  totalAmount     Float
  status          String    @default("draft")
  submittedAt     DateTime?
  submittedBy     String?
  submittedByName String?
  createdBy       String
  createdByName   String
  createdAt       DateTime
  updatedAt       DateTime

  @@index([status])
  @@index([weekEnding])
}

model WorshipServicePlan {
  id                       String    @id
  serviceDate              String
  serviceTime              String
  serviceType              String    @default("sunday")
  title                    String?
  status                   String    @default("draft")
  songs                    Json
  team                     Json
  rehearsalNotes           String?
  rehearsalDate            String?
  rehearsalTime            String?
  calendarEventId          String?
  reminderSentAt           DateTime?
  uploadDutyUserId         String?
  uploadDutyUserName       String?
  uploadDutyReminderSentAt DateTime?
  memberSuggestions        Json      @default("[]")
  publishedAt              DateTime?
  createdBy                String
  createdByName            String
  createdAt                DateTime
  updatedAt                DateTime

  @@unique([serviceDate, serviceTime])
  @@index([serviceDate])
  @@index([status])
  @@index([calendarEventId])
  @@index([uploadDutyUserId])
}

model WorshipScheduleRotation {
  id                    String    @id
  pool                  Json      @default("[]")
  serviceTime           String    @default("10:00")
  serviceKind           String    @default("sunday")
  rotationIndex         Int       @default(0)
  skipDates             Json      @default("[]")
  weeksAhead            Int       @default(8)
  uploadDutyLeadDays    Int       @default(4)
  status                String    @default("draft")
  publishedAt           DateTime?
  scheduleNotifiedAt    DateTime?
  updatedBy             String?
  updatedByName         String?
  createdAt             DateTime
  updatedAt             DateTime
}

model PrayerScheduleRotation {
  id                 String    @id
  slotType           String
  pool               Json      @default("[]")
  rotationIndex      Int       @default(0)
  skipDates          Json      @default("[]")
  weeksAhead         Int       @default(8)
  status             String    @default("draft")
  publishedAt        DateTime?
  scheduleNotifiedAt DateTime?
  updatedBy          String?
  updatedByName      String?
  createdAt          DateTime
  updatedAt          DateTime

  @@unique([slotType])
}

model PrayerAssignment {
  id             String    @id
  slotType       String
  assignmentDate String
  userId         String
  userName       String
  status         String    @default("draft")
  publishedAt    DateTime?
  notifiedAt     DateTime?
  createdAt      DateTime
  updatedAt      DateTime

  @@unique([slotType, assignmentDate])
  @@index([userId])
  @@index([slotType, assignmentDate])
  @@index([status])
}

model MinistryLeaderReport {
  id              String    @id
  reportMonth     String
  groupId         String
  groupName       String
  templateKey     String
  responses       Json
  leaderNotes     String?
  status          String    @default("draft")
  submittedAt     DateTime?
  submittedBy     String?
  submittedByName String?
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewedByName  String?
  reviewerNotes   String?
  actionSteps     String?
  createdBy       String
  createdByName   String
  createdAt       DateTime
  updatedAt       DateTime

  @@unique([reportMonth, groupId])
  @@index([reportMonth])
  @@index([groupId])
  @@index([status])
}

model WorshipSongLibrary {
  id             String   @id
  title          String
  artist         String?
  defaultKey     String   @default("C")
  bpm            Int?
  ccliNumber     String?
  youtubeVideoId String?
  youtubeUrl     String?
  chartUrl       String?
  chartFileName  String?
  notes          String?
  tags           Json?
  useCount       Int      @default(0)
  createdBy      String
  createdByName  String
  createdAt      DateTime
  updatedAt      DateTime

  @@index([title])
}

model WorshipRehearsalRecording {
  id              String   @id
  serviceDate     String
  serviceTime     String
  title           String
  audioUrl        String
  fileName        String
  durationSeconds Int?
  recordedBy      String
  recordedByName  String
  createdAt       DateTime

  @@index([serviceDate, serviceTime])
  @@index([recordedBy])
}

model GroupChatMessage {
  id             String   @id
  groupId        String
  groupName      String
  senderId       String
  senderName     String
  content        String
  reactions      Json?
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  editedAt       DateTime?
  deletedAt      DateTime?
  replyToMessageId   String?
  replyToSenderId    String?
  replyToSenderName  String?
  replyToExcerpt     String?
  createdAt      DateTime
  expiresAt      DateTime?

  @@index([groupId, createdAt])
}

model GroupChatSettings {
  groupId             String @id
  disappearingSeconds Int    @default(0)
}

model GroupChatReadState {
  id         String   @id
  groupId    String
  userId     String
  lastReadAt DateTime

  @@unique([groupId, userId])
  @@index([groupId])
}

model ChatTypingIndicator {
  id          String   @id
  channelType String
  channelId   String
  userId      String
  userName    String
  expiresAt   DateTime

  @@unique([channelType, channelId, userId])
  @@index([channelType, channelId])
}

model ChatAttachmentMeta {
  id          String   @id
  ownerId     String
  groupId     String?
  threadId    String?
  contentType String
  filename    String
  createdAt   DateTime
}

model GuestSubmission {
  id             String    @id
  name           String
  email          String?
  phone          String?
  visitDate      String?
  serviceTime    String?
  isFirstVisit   Boolean   @default(true)
  notes          String?
  status         String    @default("new")
  submittedAt    DateTime
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewedByName String?

  @@index([status])
  @@index([submittedAt])
}

model UsherSchedule {
  id              String    @id
  serviceDate     String
  serviceTime     String
  ushers          Json
  notes           String?
  status          String    @default("draft")
  publishedAt     DateTime?
  createdBy       String
  createdByName   String
  createdAt       DateTime
  updatedAt       DateTime

  @@unique([serviceDate, serviceTime])
  @@index([serviceDate])
  @@index([status])
}

model GroupServiceRoster {
  id              String    @id
  groupId         String
  serviceDate     String
  serviceTime     String
  title           String?
  assignments     Json
  notes           String?
  status          String    @default("draft")
  publishedAt     DateTime?
  createdBy       String
  createdByName   String
  createdAt       DateTime
  updatedAt       DateTime

  @@unique([groupId, serviceDate, serviceTime])
  @@index([groupId, serviceDate])
  @@index([status])
}

model GroupRosterTemplate {
  groupId   String   @id
  roles     Json
  updatedAt DateTime @updatedAt
}

model MinistryReadinessCompletion {
  id            String   @id
  userId        String
  readinessKey  String
  groupId       String
  groupName     String
  score         Int
  totalQuestions Int
  answers       Json
  agreedAt      DateTime
  source        String   @default("self_join")
  createdAt     DateTime @default(now())

  @@unique([userId, readinessKey])
  @@index([groupId, agreedAt])
  @@index([readinessKey])
}

model FeedReadState {
  id         String   @id
  userId     String
  feedKey    String
  lastReadAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, feedKey])
}

model LiveStreamSchedule {
  id              String    @id @default(cuid())
  title           String
  startsAt        DateTime
  platform        String?
  notifyEnabled   Boolean   @default(false)
  notifyBody      String?
  notifySentAt    DateTime?
  createdBy       String
  createdByName   String
  updatedAt       DateTime
}

model UrgentAlert {
  id            String    @id
  title         String
  message       String
  href          String?
  ctaLabel      String?
  imageUrl          String?
  videoUrl          String?
  artworkSquareUrl  String?
  artworkWideUrl    String?
  artworkBannerUrl  String?
  active        Boolean   @default(false)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdBy     String
  createdByName String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
  @@index([expiresAt])
}

model Poll {
  id              String       @id
  question        String
  description     String?
  createdBy       String
  creatorName     String
  campusId        String?
  targetGroupId   String?
  targetGroupName String?
  status          String       @default("open")
  allowMultiple   Boolean      @default(false)
  closesAt        DateTime?
  createdAt       DateTime     @default(now())
  options         PollOption[]
  votes           PollVote[]

  @@index([targetGroupId])
  @@index([status])
  @@index([createdAt])
}

model PollOption {
  id        String     @id
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int        @default(0)
  votes     PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String     @id
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  userName String
  votedAt  DateTime   @default(now())

  @@unique([pollId, optionId, userId])
  @@index([pollId, userId])
}

model CommsRequest {
  id             String    @id
  template       String
  title          String
  department     String?
  description    String
  targetAudience String?
  deliverables   Json      @default("[]")
  dueDate        DateTime?
  status         String    @default("submitted")
  assigneeId     String?
  assigneeName   String?
  requesterId    String
  requesterName  String
  requesterEmail String?
  calendarItemId String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([assigneeId])
}

model CommsCalendarItem {
  id            String    @id
  title         String
  channel       String
  weekStart     DateTime
  scheduledDate DateTime?
  status        String    @default("planned")
  color         String?
  body          String?
  requestId     String?
  assigneeId    String?
  assigneeName  String?
  dueDate       DateTime?
  promotedAs    Json?
  createdBy     String
  createdByName String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([weekStart])
  @@index([channel])
  @@index([status])
}

model CoupleLink {
  id              String    @id
  userAId         String
  userBId         String
  status          String    @default("pending")
  requestedBy     String
  anniversaryDate String?
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([status])
}

model GroupResource {
  id            String   @id
  groupId       String
  title         String
  description   String?
  url           String?
  category      String   @default("marriage")
  sortOrder     Int      @default(0)
  createdBy     String
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([groupId, sortOrder])
}

model CouplePrayerPost {
  id           String   @id
  coupleLinkId String
  authorId     String
  authorName   String
  content      String
  type         String   @default("prayer")
  createdAt    DateTime @default(now())

  @@index([coupleLinkId, createdAt])
}

model GroupMinistryHubAnnouncement {
  groupId       String   @id
  title         String
  body          String
  updatedBy     String?
  updatedByName String?
  updatedAt     DateTime @updatedAt
}

model GroupMinistryPrayerPost {
