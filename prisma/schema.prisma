generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String         @id
  name                String
  email               String         @unique
  phone               String?
  campusId            String
  role                String         @default("member")
  avatarUrl           String?
  passwordHash        String
  pushEnabled         Boolean        @default(true)
  notifyDevotions     Boolean        @default(true)
  notifyMessages      Boolean        @default(true)
  notifyAnnouncements Boolean        @default(true)
  notifyWorship       Boolean        @default(true)
  createdAt           DateTime
  updatedAt           DateTime
  family              FamilyMember[]
  sessions            Session[]
  activities          ActivityLog[]
}

model FamilyMember {
  id           String  @id
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  birthYear    String?
  notes        String?
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model ActivityLog {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  label     String
  createdAt DateTime
}

model MessageThread {
  id               String    @id
  participantAId   String
  participantBId   String
  participantNames Json
  lastMessage      String
  lastMessageAt    DateTime
  createdAt        DateTime
  messages         Message[]
}

model Message {
  id         String        @id
  threadId   String
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId   String
  senderName String
  content    String
  createdAt  DateTime
  readAt     DateTime?
}

model UserBlock {
  id              String   @id
  blockerId       String
  blockedUserId   String
  blockedUserName String
  createdAt       DateTime
}

model MessageReport {
  id               String   @id
  reporterId       String
  reporterName     String
  reportedUserId   String
  reportedUserName String
  threadId         String?
  reason           String
  status           String   @default("open")
  createdAt        DateTime
}

model Group {
  id              String   @id
  name            String
  description     String
  category        String
  campusId        String?
  createdBy       String
  creatorName     String
  visibility      String
  meetingSchedule String?
  meetingLink     String?
  memberIds       Json
  adminIds        Json
  requiresApproval Boolean @default(false)
  isSystem        Boolean @default(false)
  signupVisible   Boolean @default(true)
  createdAt       DateTime
  updatedAt       DateTime
}

model GroupJoinRequest {
  id             String    @id
  groupId        String
  groupName      String
  userId         String
  userName       String
  userEmail      String
  status         String    @default("pending")
  requestedAt    DateTime
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewedByName String?
}

model CommunityPost {
  id              String    @id
  author          String
  campusId        String
  content         String
  timeAgo         String
  type            String
  reactions       Int       @default(0)
  targetGroupId   String?
  targetGroupName String?
  createdAt       DateTime  @default(now())
  comments        Comment[]
}

model Comment {
  id        String        @id
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime
}

model Devotion {
  id          String    @id
  title       String
  verse       String
  reference   String
  readingTime String
  content     String
  prayer      String
  date        String
  published   Boolean   @default(true)
  authorId    String?
  authorName  String?
  createdAt   DateTime?
  updatedAt   DateTime?
  publishAt   DateTime?
  notifiedAt  DateTime?
}

model ChurchEvent {
  id               String   @id
  title            String
  date             String
  time             String
  location         String
  campusId         String?
  groupId          String?
  groupName        String?
  startsOn         String?
  endsOn           String?
  recurringWeekday Int?
  published        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime
  updatedAt        DateTime
}

model Meeting {
  id               String   @id
  title            String
  campusId         String
  host             String
  schedule         String
  platform         String
  joinUrl          String?
  location         String?
  meetingId        String?
  passcode         String?
  startsOn         String?
  endsOn           String?
  recurringWeekday Int?
  published        Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime
  updatedAt        DateTime
}

model RateLimitEntry {
  key     String   @id
  count   Int
  resetAt DateTime
}

model PushSubscription {
  id           String   @id
  userId       String
  endpoint     String   @unique
  subscription Json
  createdAt    DateTime
  updatedAt    DateTime
}

model VolunteerCheckIn {
  id             String   @id
  name           String
  ministry       String
  checkedInAt    DateTime
  atChurch       Boolean
  distanceMeters Float
}

model KidCheckIn {
  id           String    @id
  parentName   String
  childName    String
  ageGroup     String
  service      String
  notes        String?
  securityCode String
  checkedInAt  DateTime
  checkedOutAt DateTime?
}

model UnavailabilityRequest {
  id          String    @id
  personName  String
  group       String
  startDate   String
  endDate     String
  reason      String
  status      String
  submittedAt DateTime
  reviewedAt  DateTime?
  reviewedBy  String?
}

model GalleryPhoto {
  id           String   @id
  url          String
  title        String
  album        String
  uploadedAt   DateTime
  uploadedBy   String?
  linkProvider String?
  visibility   String   @default("private")
}

model GalleryDownload {
  id             String   @id
  photoId        String
  photoTitle     String
  userId         String
  userName       String
  userEmail      String
  downloadedAt   DateTime
  acceptedPolicy Boolean
  policyVersion  String
}

model MediaClip {
  id          String    @id
  title       String
  platform    String
  url         String
  videoId     String?
  thumbnail   String?
  publishedAt DateTime?
}

model MeetingClick {
  id           String   @id
  userId       String
  userName     String
  userEmail    String
  meetingId    String?
  meetingTitle String
  groupId      String?
  groupName    String?
  campusId     String?
  platform     String?
  source       String
  joinUrl      String
  clickedAt    DateTime

  @@index([clickedAt])
  @@index([groupId])
  @@index([meetingId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime
}

model GivingRecord {
  id             String   @id
  userId         String?
  donorName      String
  donorEmail     String?
  amount         Float
  currency       String   @default("USD")
  fund           String
  method         String
  givenOn        String
  campusId       String?
  notes          String?
  source         String   @default("manual")
  stripeSessionId String? @unique
  stripeInvoiceId String? @unique
  recordedBy     String
  recordedByName String
  createdAt      DateTime
  updatedAt      DateTime

  @@index([givenOn])
  @@index([userId])
  @@index([fund])
}

model FinanceWeeklySheet {
  id              String    @id
  weekEnding      String    @unique
  lines           Json
  notes           String?
  totalAmount     Float
  status          String    @default("draft")
  submittedAt     DateTime?
  submittedBy     String?
  submittedByName String?
  createdBy       String
  createdByName   String
  createdAt       DateTime
  updatedAt       DateTime

  @@index([status])
  @@index([weekEnding])
}

model WorshipServicePlan {
  id               String    @id
  serviceDate      String
  serviceTime      String
  serviceType      String    @default("sunday")
  title            String?
  status           String    @default("draft")
  songs            Json
  team             Json
  rehearsalNotes   String?
  rehearsalDate    String?
  rehearsalTime    String?
  calendarEventId  String?
  reminderSentAt   DateTime?
  publishedAt      DateTime?
  createdBy        String
  createdByName    String
  createdAt        DateTime
  updatedAt        DateTime

  @@unique([serviceDate, serviceTime])
  @@index([serviceDate])
  @@index([status])
  @@index([calendarEventId])
}

model WorshipSongLibrary {
  id             String   @id
  title          String
  artist         String?
  defaultKey     String   @default("C")
  bpm            Int?
  ccliNumber     String?
  chartUrl       String?
  chartFileName  String?
  notes          String?
  tags           Json?
  useCount       Int      @default(0)
  createdBy      String
  createdByName  String
  createdAt      DateTime
  updatedAt      DateTime

  @@index([title])
}

model GuestSubmission {
  id             String    @id
  name           String
  email          String?
  phone          String?
  visitDate      String?
  serviceTime    String?
  isFirstVisit   Boolean   @default(true)
  notes          String?
  status         String    @default("new")
  submittedAt    DateTime
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewedByName String?

  @@index([status])
  @@index([submittedAt])
}

model UsherSchedule {
  id              String    @id
  serviceDate     String
  serviceTime     String
  ushers          Json
  notes           String?
  status          String    @default("draft")
  publishedAt     DateTime?
  createdBy       String
  createdByName   String
  createdAt       DateTime
  updatedAt       DateTime

  @@unique([serviceDate, serviceTime])
  @@index([serviceDate])
  @@index([status])
}
