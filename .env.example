# YouTube channel ID for in-app live player (About → Share channel on YouTube)
# NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxx

# Facebook live video post URLs (paste when service starts — copy link from the live video)
# NEXT_PUBLIC_FACEBOOK_CITY_LIVE_URL=https://www.facebook.com/ShanahCity/videos/1234567890
# NEXT_PUBLIC_FACEBOOK_REVIVAL_LIVE_URL=https://www.facebook.com/ShanahRevival/videos/1234567890

# Facebook Page cover photo for live/media hero only (wordless banner — no post flyers)
# Create at developers.facebook.com → your app → Tools → Graph API Explorer → Page access token
# FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token
# Optional page IDs (defaults: ShanahCity, ShanahRevival)
# FACEBOOK_CITY_PAGE_ID=ShanahCity
# FACEBOOK_REVIVAL_PAGE_ID=ShanahRevival

# YouTube Shorts clip IDs for /live → Clips tab (comma-separated; add titles in data/media-clips.json)
# NEXT_PUBLIC_YOUTUBE_CLIP_IDS=abc123,def456

# Church giving links (only configured platforms show on /give)
# NEXT_PUBLIC_GIVE_ZEFFY_URL=https://www.zeffy.com/en-US/donation-form/your-form-id
# NEXT_PUBLIC_GIVE_PAYPAL_USERNAME=ShanahCity
# NEXT_PUBLIC_GIVE_PAYPAL_URL=https://paypal.me/ShanahCity
# NEXT_PUBLIC_GIVE_CASHAPP_TAG=ShanahCity
# NEXT_PUBLIC_GIVE_ZELLE_EMAIL=finance@shanahcity.org
# NEXT_PUBLIC_GIVE_ZELLE_PHONE=720-278-3175
# NEXT_PUBLIC_GIVE_VENMO_USERNAME=ShanahCity

# WORSHIP_GROUP_ID=group-choir

# Shanah-branded online giving (Stripe Checkout — Phase 2)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://your-app.vercel.app/api/giving/webhook
# Events: checkout.session.completed, invoice.payment_succeeded

# PostgreSQL connection (required for production; enables DB-backed stores when set)
# Use Neon's pooled URL for the app (hostname includes -pooler):
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Optional but recommended: direct URL for Prisma CLI migrations (no -pooler in hostname).
# If omitted, db:deploy auto-strips -pooler from DATABASE_URL.
# DIRECT_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# Vercel builds skip migrate deploy (avoids Neon pooler lock timeouts).
# After you change prisma/schema.prisma, run locally before pushing: npm run db:deploy

# Outlook church calendar (published ICS from admin@shanahcity.org)
# Outlook on the web → Calendar → Settings → Shared calendars → Publish a calendar
# Choose the church calendar, "Can view all details", then paste the ICS link:
# OUTLOOK_CALENDAR_ICS_URL=https://outlook.office365.com/owa/calendar/xxxx/calendar.ics


# Scheduled devotion push notifications (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=generate-a-long-random-string
# Hobby plan: cron can run once per day only (vercel.json uses 0 13 * * * = 1pm UTC daily).
# Pro plan: change vercel.json schedule to */5 * * * * for every 5 minutes.

# Vercel Blob storage for gallery uploads (production)
# Vercel may inject BLOB_STORE_ID automatically when you connect Blob.
# For local uploads, create a Read-Write token in Vercel → Storage → Blob → Tokens.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# BLOB_STORE_ID=store_xxxxxxxx

# Email via Resend (https://resend.com) — password reset, guest thank-yous, giving reports
# 1) Create API key → RESEND_API_KEY
# 2) Resend → Domains → add shanahcity.org → add the DNS records they show → wait for Verified
# 3) Set ONE from address (must use a verified domain, not a random Gmail address):
# RESEND_FROM_EMAIL=Shanah City <noreply@shanahcity.org>
# Optional aliases (otherwise RESEND_FROM_EMAIL is used for everything):
# PASSWORD_RESET_FROM_EMAIL=Shanah City <noreply@shanahcity.org>
# GIVING_REPORT_FROM_EMAIL=Shanah City <giving@shanahcity.org>
# RESEND_API_KEY=re_xxxxxxxx
# Public site URL used in reset links and the native app WebView (production).
# NEXT_PUBLIC_APP_URL=https://shanah-city.vercel.app

# Capacitor native apps load this URL. Default is the Vercel app (not shanahcity.org marketing site).
# CAPACITOR_SERVER_URL=https://shanah-city.vercel.app
# When shanahcity.org points at the new app, you can switch to:
# CAPACITOR_SERVER_URL=https://shanahcity.org
# Local device testing: CAPACITOR_SERVER_URL=http://192.168.1.10:3000
#
# Android Studio path (Windows) if npm run mobile:android cannot find it automatically:
# CAPACITOR_ANDROID_STUDIO_PATH=C:\Program Files\Android\Android Studio2\bin\studio64.exe
#
# GitHub Actions → Android Play Store workflow secrets (repo Settings → Secrets and variables → Actions):
# ANDROID_KEYSTORE_BASE64          one-line base64 of upload keystore (.jks) — NOT certutil PEM output
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\upload.jks")) | Set-Clipboard
# ANDROID_KEYSTORE_PASSWORD        keystore password
# ANDROID_KEY_ALIAS                key alias inside the keystore
# ANDROID_KEY_PASSWORD             key password (often same as keystore password)
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON full Play Console service account JSON (one line)
#
# Create the service account in Google Cloud, grant Play Console access under Users and permissions,
# then enable the Google Play Android Developer API for that project.
#
# Releases: push to main uploads to Play internal testing. Promote 1.0.x to production in Play Console
# (Release → Testing → Internal testing → Promote release), or run Actions → Android Play Store manually
# with track "production" (requires a new versionCode). Optional GitHub environment "play-store-production"
# can require approval before production uploads.

# Gallery upload access: members of this group (by id or name) can upload photos
# MEDIA_GROUP_ID=group_xxxxxxxx
# MEDIA_GROUP_NAME=Media Team

# Legacy optional PINs (no longer used by the app — ministry access uses groups + Admin Group)
# LEADER_PIN=shanahleader
# GALLERY_UPLOAD_PIN=shanahcity

# Web push notifications (generate your own keys with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)")
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BNhXjCbEbKqUKl9KZAiDsMoglDMKgXHIszEsWgbMM0Yp9wKwm_hlNwENdODJpEtD4ucqSdvMBElVupNsBmh9PVw
VAPID_PRIVATE_KEY=blA-QYce07d0qNH4imzQE4a8tc__IHE7jsGPmWPcctg
VAPID_SUBJECT=mailto:admin@shanahcity.org

# Native phone push (Play Store + TestFlight)
# Android: Firebase Cloud Messaging. Paste the full service account JSON on one line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Also put google-services.json in android/app/ from Firebase Console.
#
# iOS: Apple Push (APNs auth key from developer.apple.com → Keys)
# APNS_KEY_P8=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=S4MRT53FN9
# APNS_BUNDLE_ID=org.shanahcity.app
# APNS_PRODUCTION=true
