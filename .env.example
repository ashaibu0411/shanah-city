# YouTube channel ID for in-app live player (About → Share channel on YouTube)
# NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxx

# Facebook live video post URLs (paste when service starts — copy link from the live video)
# NEXT_PUBLIC_FACEBOOK_CITY_LIVE_URL=https://www.facebook.com/ShanahCity/videos/1234567890
# NEXT_PUBLIC_FACEBOOK_REVIVAL_LIVE_URL=https://www.facebook.com/ShanahRevival/videos/1234567890

# YouTube Shorts clip IDs for /live → Clips tab (comma-separated; add titles in data/media-clips.json)
# NEXT_PUBLIC_YOUTUBE_CLIP_IDS=abc123,def456

# Church giving links (only configured platforms show on /give)
# NEXT_PUBLIC_GIVE_ZEFFY_URL=https://www.zeffy.com/en-US/donation-form/your-form-id
# NEXT_PUBLIC_GIVE_PAYPAL_USERNAME=ShanahCity
# NEXT_PUBLIC_GIVE_PAYPAL_URL=https://paypal.me/ShanahCity
# NEXT_PUBLIC_GIVE_CASHAPP_TAG=ShanahCity
# NEXT_PUBLIC_GIVE_ZELLE_EMAIL=admin@shanahcity.org
# NEXT_PUBLIC_GIVE_ZELLE_PHONE=720-278-3175
# NEXT_PUBLIC_GIVE_VENMO_USERNAME=ShanahCity

# PostgreSQL connection (required for production; enables DB-backed stores when set)
# DATABASE_URL=postgresql://user:password@localhost:5432/shanah_city

# Vercel Blob storage for gallery uploads (production)
# Vercel may inject BLOB_STORE_ID automatically when you connect Blob.
# For local uploads, create a Read-Write token in Vercel → Storage → Blob → Tokens.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# BLOB_STORE_ID=store_xxxxxxxx

GALLERY_UPLOAD_PIN=shanahcity

# Leader PIN for approving choir/pastor calendar requests and writing devotions
LEADER_PIN=shanahleader

