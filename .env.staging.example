# Copy to .env.staging.local (gitignored) for ONE-TIME staging DB bootstrap from your machine.
# STAGING_DATABASE_CONFIRM=shanah-city-staging
# Do NOT commit real credentials. Do NOT use production DATABASE_URL here.
#
# Usage (PowerShell, one session):
#   Get-Content .env.staging.local | ForEach-Object { ... }  OR load manually, then:
#   npm.cmd run db:deploy
#
# Staging Vercel project gets the same DATABASE_URL / DIRECT_URL via dashboard (Production env on that project).

# DATABASE_URL=postgresql://...@...-pooler....neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://...@....neon.tech/neondb?sslmode=require

# Set on Vercel staging project only — NOT on live shanah-city production:
# MARRIAGE_HUB_STAGE2_ENABLED=1
# NEXT_PUBLIC_MARRIAGE_STAGE2=1
# MARRIAGE_HUB_STAGE2_INTIMACY_APPROVED=   (leave unset)

# NEXT_PUBLIC_APP_URL=https://shanah-city-staging.vercel.app
# MARRIAGE_CURRICULUM_ADMIN_USER_IDS=user-id-1
# MARRIAGE_COUNSELOR_USER_IDS=user-id-2
